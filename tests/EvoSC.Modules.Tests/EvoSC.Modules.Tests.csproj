<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <RootNamespace>EvoSC.Modules.Tests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.5.0" />
        <PackageReference Include="Moq" Version="4.18.4" />
        <PackageReference Include="SonarAnalyzer.CSharp" Version="9.5.0.73987">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="xunit" Version="2.4.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.4.5">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="coverlet.collector" Version="3.2.0">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\EvoSC.Common\EvoSC.Common.csproj" />
        <ProjectReference Include="..\..\src\EvoSC.Modules\EvoSC.Modules.csproj" />
        <ProjectReference Include="..\..\src\EvoSC.Modules.Build\EvoSC.Modules.Build.csproj" ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\ModuleFixtures\ContractApiProviderModule\ContractApiProviderModule.csproj" ReferenceOutputAssembly="false" EvoSCModule="true" />
        <ProjectReference Include="..\ModuleFixtures\ContractApiConsumerModule\ContractApiConsumerModule.csproj" ReferenceOutputAssembly="false" EvoSCModule="true" />
        <ProjectReference Include="..\ModuleFixtures\CyclicModuleA\CyclicModuleA.csproj" ReferenceOutputAssembly="false" EvoSCModule="true" />
        <ProjectReference Include="..\ModuleFixtures\CyclicModuleB\CyclicModuleB.csproj" ReferenceOutputAssembly="false" EvoSCModule="true" />
        <ProjectReference Include="..\ModuleFixtures\InternalFixtureModule\InternalFixtureModule.csproj" ReferenceOutputAssembly="false" EvoSCModule="true" />
        <!-- The example stages into its own output, so this only makes sure it is built before the
             test that loads it. -->
        <ProjectReference Include="..\..\examples\SimpleModule\SimpleModule.csproj" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <Import Project="..\..\src\EvoSC.Modules.Build\build\EvoSC.Modules.Build.targets" />

</Project>